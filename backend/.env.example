# Provider do modelo REFINADOR (não é o destino do prompt): anthropic | openai | claude-cli
#   anthropic / openai: API paga (precisa de chave e de créditos).
#   claude-cli: usa a SUA assinatura do Claude (Pro/Max) pelo Claude Code instalado no Mac — sem custo de API,
#               conta só nos limites de uso do plano. Não precisa de chave; precisa do Claude Code logado
#               (Terminal: claude → /login). Uso pessoal, no seu próprio Mac.
# Se vazio, usa o provider cuja chave estiver definida (Anthropic tem prioridade se ambas existirem).
PROMPT_COMPILER_PROVIDER=claude-cli
# Para usar a sua própria chave de API, troque a linha acima por uma destas
# e preencha a chave correspondente mais abaixo:
# PROMPT_COMPILER_PROVIDER=anthropic
# PROMPT_COMPILER_PROVIDER=openai

# Modelo do provider escolhido. Obrigatório (não há modelo hardcoded no código).
# Ex.: claude-sonnet-5-5 (Anthropic) ou o modelo OpenAI de sua preferência.
PROMPT_COMPILER_MODEL=claude-sonnet-5-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcional: esforço de raciocínio (low | medium | high). "medium" foi o melhor equilíbrio qualidade × tempo no eval (08/10).
# Deixe vazio para modelos que não suportam o parâmetro.
PROMPT_COMPILER_EFFORT=medium

PORT=8787
# 127.0.0.1 = acessível apenas localmente
HOST=127.0.0.1

# Opcionais
# claude-cli: caminho absoluto do Claude Code (padrão: ~/.local/bin/claude, a instalação nativa)
# PROMPT_COMPILER_CLAUDE_BIN=/Users/<voce>/.local/bin/claude
# claude-cli, plano B se o serviço não conseguir ler o login do Chaveiro: token de 1 ano da sua
# assinatura, gerado por você com `claude setup-token` (é uma credencial: nunca compartilhe).
# CLAUDE_CODE_OAUTH_TOKEN=
# PROMPT_COMPILER_TIMEOUT_MS=45000
# PROMPT_COMPILER_MAX_TOKENS=16000
# Origens permitidas (CORS). Para fixar a sua extensão: chrome-extension://<id>
# ALLOWED_ORIGINS=chrome-extension://*
# Fallback server-side em caso de recusa (modelos Claude 5.x). "false" desativa.
# ANTHROPIC_REFUSAL_FALLBACK=true
# Formato padrão quando a requisição não informa: markdown (padrão) | auto
# PROMPT_DEFAULT_FORMAT=markdown
